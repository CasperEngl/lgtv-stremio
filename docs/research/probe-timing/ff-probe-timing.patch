+// ==== PROBE-TIMING (lgtv-stremio ticket 19). Measuring code for one build; never merged. ====
+/// When the demuxer's open sequence made its first request, and whether it is still probing.
+static PT_T0: std::sync::Mutex<Option<std::time::Instant>> = std::sync::Mutex::new(None);
+static PT_PROBING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static PT_SEEKS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Milliseconds since the open sequence's first request.
+fn pt_ms() -> u128 {
+    PT_T0
+        .lock()
+        .unwrap()
+        .map_or(0, |t| t.elapsed().as_millis())
+}
+
+/// One tag of a stream's metadata dictionary, copied; empty when absent.
+unsafe fn pt_tag(s: *mut AVStream, key: &std::ffi::CStr) -> String {
+    let dict = *((s as *const u8).add(OFF_STREAM_METADATA) as *const *const AVDictionary);
+    if dict.is_null() {
+        return String::new();
+    }
+    let e = av_dict_get(dict, key.as_ptr(), std::ptr::null(), 0);
+    if e.is_null() || (*e).value.is_null() {
+        return String::new();
+    }
+    std::ffi::CStr::from_ptr((*e).value)
+        .to_string_lossy()
+        .into_owned()
+}
